<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Combat.uss" />
    <ui:Template name="dash" src="Dash.uxml" />
    <ui:Template name="input-hints" src="InputHints.uxml" />
    <ui:Template name="main-menu" src="MainMenu.uxml" />
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="screen" picking-mode="Ignore">
            <ui:VisualElement name="world-cues" class="screen" picking-mode="Ignore" />
            <ui:VisualElement name="objective" class="objective panel" picking-mode="Ignore">
                <ui:Label text="CLEAR ALL ENEMIES" class="objective-title" picking-mode="Ignore" />
                <ui:Label name="wave" text="Wave 1/5" picking-mode="Ignore" />
                <ui:Label name="timer" text="180s remaining" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="skill-status" class="skill-status panel">
                <ui:Label name="score-status" text="Score 0" />
                <ui:Button name="skills-button" text="Skills · 0 tokens" />
                <ui:Label name="impact-status" text="Impact ×0" />
            </ui:VisualElement>
            <ui:Label name="token-popup" class="token-popup panel hidden" text="Skill token earned! Choose Impact or Dash" picking-mode="Ignore" />
            <ui:Label name="damage-reason" class="damage-reason hidden" picking-mode="Ignore" />
            <ui:Label name="map-legend" class="map-legend panel" picking-mode="Ignore" />
            <ui:Button name="help-button" text="Help" class="help-button" />
            <ui:VisualElement name="combo" class="combo panel hidden" picking-mode="Ignore">
                <ui:Label name="combo-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="player-warning" class="player-warning hidden" picking-mode="Ignore" />
            <ui:VisualElement name="player-status" class="player-status" picking-mode="Ignore">
                <ui:Instance name="combat-dash" template="dash" class="combat-dash" picking-mode="Ignore" />
                <ui:VisualElement name="health" class="meter-row" picking-mode="Ignore">
                    <ui:VisualElement class="meter heart" picking-mode="Ignore"><ui:VisualElement class="fill heart-fill" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="meter heart" picking-mode="Ignore"><ui:VisualElement class="fill heart-fill" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="meter heart" picking-mode="Ignore"><ui:VisualElement class="fill heart-fill" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="meter heart" picking-mode="Ignore"><ui:VisualElement class="fill heart-fill" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement class="meter heart" picking-mode="Ignore"><ui:VisualElement class="fill heart-fill" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="dash-uses" class="meter-row dash-uses" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="map" class="map" picking-mode="Ignore">
                <ui:VisualElement name="map-obstacles" class="screen" picking-mode="Ignore" />
                <ui:VisualElement name="map-markers" class="screen" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="damage" class="screen damage" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Instance name="menu" template="main-menu" class="screen hidden" />
        <ui:VisualElement name="modal" class="screen modal hidden">
            <ui:VisualElement name="wave-preview" class="card panel preview-card hidden">
                <ui:Label name="preview-heading" class="heading" />
                <ui:Label name="preview-summary" class="preview-summary" />
                <ui:VisualElement name="preview-enemies" class="preview-enemies" />
                <ui:Button name="start-wave" text="Start Wave" />
            </ui:VisualElement>
            <ui:VisualElement name="skill-choice" class="card panel hidden">
                <ui:Label text="Choose your skill" class="heading" />
                <ui:Label name="skill-balance" class="body" />
                <ui:Label text="Impact: next fast hit deals double damage. Dash: restore one use; cooldown stays unchanged." class="preview-summary" />
                <ui:VisualElement class="actions">
                    <ui:Button name="buy-impact" text="1 token → Impact Charge" />
                    <ui:Button name="buy-dash" text="1 token → Dash use" />
                    <ui:Button name="close-skills" text="Resume" />
                </ui:VisualElement>
                <ui:Label name="purchase-feedback" class="preview-summary" />
            </ui:VisualElement>
            <ui:VisualElement name="guide" class="card panel hidden">
                <ui:Label name="guide-progress" class="eyebrow" />
                <ui:VisualElement name="guide-pages">
                    <ui:VisualElement>
                        <ui:Label text="One player. Two forms." class="heading" />
                        <ui:Label text="Use the controls below to move or switch between robot and ball." class="body guide-control-copy" />
                        <ui:Instance template="input-hints" class="input-hints show-form show-move" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hidden">
                        <ui:Label text="Build speed in ball form." class="heading" />
                        <ui:Label text="Bounce off walls for a speed boost. The cyan halo shows when you're ready to bonk. Dash is available in ball form. The circles below your hearts show how many uses remain." class="body guide-control-copy" />
                        <ui:Instance template="input-hints" class="input-hints show-dash" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hidden">
                        <ui:Label text="Robot form gives you control." class="heading" />
                        <ui:Label text="Switch to robot form to steer more precisely and recover from dizziness. Switch before the dizziness warning expires to avoid a brief stun." class="body" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hidden">
                        <ui:Label text="Watch your health." class="heading" />
                        <ui:Label text="The red hearts show your health. Collect green health pickups to refill them." class="body" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hidden">
                        <ui:Label text="Charge your impact." class="heading" />
                        <ui:Label name="guide-impact" text="Start with four green charges below your health. Every {0} points adds another. Press Q in ball form to Dash towards an enemy." class="body" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="actions">
                    <ui:Button name="back" text="Back" />
                    <ui:Button name="close-help" text="Close Help" />
                    <ui:Button name="next" text="Next" />
                    <ui:Button name="done" text="Done" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="results" class="card panel hidden">
                <ui:Label name="result-wave" text="Wave 1 result" class="eyebrow" />
                <ui:Label name="result-title" text="Wave cleared!" class="heading" />
                <ui:Label name="result-detail" class="body" />
                <ui:VisualElement class="actions">
                    <ui:Button name="main-menu" text="Main Menu" />
                    <ui:Button name="retry-wave" text="Retry Wave" />
                    <ui:Button name="next-wave" text="Next Wave" />
                    <ui:Button name="restart-run" text="Restart Run" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
