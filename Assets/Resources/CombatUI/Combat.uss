.screen { position: absolute; top: 0; right: 0; bottom: 0; left: 0; color: rgb(240, 246, 251); font-size: 18px; }
.hidden { display: none; }
.panel { background-color: rgba(9, 14, 23, 0.94); border-radius: 8px; }
.objective { position: absolute; top: 16px; align-self: center; min-width: 340px; flex-direction: row; align-items: center; justify-content: center; padding: 10px 18px; }
.objective > Label { margin: 0 6px; }
.objective-title { -unity-font-style: bold; }
.timer-low { color: rgb(255, 211, 76); }
.help-button { position: absolute; top: 16px; right: 20px; }
.combo { position: absolute; align-self: center; top: 72px; padding: 5px 14px; -unity-font-style: bold; }
.reward { color: rgb(255, 211, 76); }
.player-warning { position: absolute; margin: 0; translate: -50% 0; color: rgb(255, 211, 76); -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
.player-status { position: absolute; bottom: 18px; left: 20px; }
.meter-row { flex-direction: row; align-items: center; }
.meter { position: relative; overflow: hidden; width: 39px; height: 36px; margin-right: 6px; margin-bottom: 2px; }
.fill { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.empty { display: none; }
.heart { background-image: url("HeartTrack.png"); }
.heart-fill { background-image: url("HeartFill.png"); }
.orb { width: 31px; height: 31px; margin-right: 8px; background-image: url("OrbTrack.png"); }
.orb-fill { height: 100%; background-image: url("OrbFill.png"); }
.dash-use-spent .orb-fill { display: none; }
.dash-uses { flex-wrap: wrap; }
.map { position: absolute; bottom: 18px; right: 20px; width: 220px; height: 220px; overflow: hidden; background-color: rgb(31, 47, 61); border-width: 2px; border-color: rgb(100, 119, 136); border-radius: 6px; }
.map-obstacle { position: absolute; background-color: rgb(100, 119, 136); }
.map-pin { position: absolute; translate: -50% -50%; width: 16px; height: 16px; border-width: 2px; border-color: rgb(8, 15, 24); border-radius: 2px; }
.map-minion { width: 12px; height: 12px; }
.map-player { width: 22px; height: 22px; background-color: rgb(63, 229, 255); }
.map-health { background-color: rgb(76, 250, 112); }
.cue { position: absolute; translate: -50% -100%; align-items: center; }
.cue Label { margin: 0; font-size: 15px; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
.enemy-health { flex-direction: row; height: 6px; min-width: 54px; margin-top: 2px; padding: 1px; border-radius: 2px; background-color: rgb(8, 15, 24); }
.health-pip { flex-grow: 1; margin: 0 1px; background-color: rgb(76, 255, 139); }
.health-pip-lost { background-color: rgb(86, 94, 102); }
.health-pip-flash { background-color: white; }
.damage { opacity: 0; background-color: rgba(255, 20, 13, 0.08); border-width: 14px; border-color: rgba(255, 20, 13, 0.55); }
.modal { align-items: center; justify-content: center; background-color: rgba(6, 10, 18, 0.58); }
.card { width: 76%; max-width: 900px; padding: 24px 30px; border-left-width: 4px; border-left-color: rgb(63, 229, 255); }
.eyebrow { color: rgb(63, 229, 255); font-size: 17px; -unity-font-style: bold; }
.heading { font-size: 30px; -unity-font-style: bold; white-space: normal; }
.body { font-size: 21px; white-space: normal; min-height: 110px; margin: 12px 0; }
.actions { flex-direction: row; justify-content: space-between; }
Button { min-height: 40px; padding: 5px 16px; background-color: rgb(27, 59, 80); color: rgb(240, 246, 251); border-width: 0; border-radius: 5px; }
Button:hover, Button:focus { background-color: rgb(37, 87, 112); }
.fill { top: auto; background-position-x: center; background-position-y: bottom; background-repeat: no-repeat; }
.player-warning { translate: -50% -45px; }
.map-obstacle { min-width: 1px; min-height: 1px; }
.dash-panel { align-self: flex-start; width: 174px; padding: 4px; }
.combat-dash { align-self: flex-start; margin-bottom: 6px; }
.tutorial-dash { position: absolute; top: 68px; right: 20px; }
.dash-status { align-self: center; margin: 1px 0 4px 0; font-size: 14px; }
Button:disabled { background-color: rgb(37, 48, 60); color: rgb(155, 174, 188); }
.tutorial-card { position: absolute; left: 20px; top: 16px; width: 52%; max-width: 510px; padding: 12px 16px; border-left-width: 4px; border-left-color: rgb(63, 229, 255); }
.tutorial-title { font-size: 23px; -unity-font-style: bold; white-space: normal; }
.tutorial-copy { font-size: 17px; white-space: normal; }
.tutorial-done { align-self: flex-start; margin-top: 8px; }
.practice-dizziness { flex-direction: row; align-items: center; margin-top: 4px; }
.practice-meter-label { font-size: 14px; margin-right: 10px; }
.practice-track { height: 6px; width: 42%; background-color: rgb(45, 57, 72); border-radius: 3px; overflow: hidden; }
.practice-fill { height: 100%; width: 0%; background-color: rgb(255, 176, 77); }

.menu-screen { background-color: rgb(9, 17, 30); align-items: center; justify-content: center; }
.menu-title { margin: 8px 0 0 0; font-size: 76px; -unity-font-style: bold; }
.menu-actions { margin-top: 32px; justify-content: center; }
.menu-actions Button { min-width: 156px; min-height: 52px; margin: 0 6px; font-size: 19px; -unity-font-style: bold; }
.menu-start { background-color: rgb(68, 221, 241); color: rgb(9, 17, 30); }
.menu-start:hover, .menu-start:focus { background-color: rgb(146, 241, 250); }
.menu-tutorial { background-color: rgb(26, 48, 67); }
.practice-countdown { color: rgb(255, 211, 76); font-size: 15px; margin: 0 0 0 10px; -unity-font-style: bold; }
.guide-control-copy { min-height: 0; margin-bottom: 0; }
