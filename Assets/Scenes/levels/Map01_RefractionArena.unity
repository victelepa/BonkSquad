  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EnemyWaveController
  player: {fileID: 1094164506}
  health: {fileID: 1094164507}
  placement: {fileID: 324729112}
  waves:
  - title: Learn to bonk
    introduction: Just four slow minions. Build speed and hit them in ball form.
    prefab: {fileID: 0}
    basicMinions: 4
    minionSpeedInDiameters: 0.65
    count: 0
    seconds: 180
    additionalGroups: []
  - title: Meet the spawner
    introduction: One spawner joins a few minions. Stop the source, then clear its
      children.
    prefab: {fileID: 7076426847113777988, guid: 978949b8623a64d8b8d1a0e16540c2b8, type: 3}
    basicMinions: 3
    minionSpeedInDiameters: 1.2
    count: 1
    seconds: 180
    additionalGroups: []
  - title: Watch for mines
    introduction: One mine layer. Avoid its warning rings and line up a fast hit.
    prefab: {fileID: 3021923979590987134, guid: 5717f51dd1e6a4f2e8580c4e584694b9, type: 3}
    basicMinions: 4
    minionSpeedInDiameters: 1.2
    count: 1
    seconds: 180
    additionalGroups: []
  - title: Keep moving
    introduction: One mortar. Leave its landing marks before returning to attack.
    prefab: {fileID: 1804741076410313430, guid: 4a2db4bc0afe74ce4b4e297ff9a61090, type: 3}
    basicMinions: 4
    minionSpeedInDiameters: 1.2
    count: 1
    seconds: 180
    additionalGroups: []
  - title: All Types
    introduction: One of each specialist. Use the map symbols to plan your route.
    prefab: {fileID: 7076426847113777988, guid: 978949b8623a64d8b8d1a0e16540c2b8, type: 3}
    basicMinions: 4
    minionSpeedInDiameters: 1.2
    count: 1
    seconds: 180
    additionalGroups:
    - prefab: {fileID: 3021923979590987134, guid: 5717f51dd1e6a4f2e8580c4e584694b9, type: 3}
      count: 1
    - prefab: {fileID: 1804741076410313430, guid: 4a2db4bc0afe74ce4b4e297ff9a61090, type: 3}
      count: 1
  minionPrefab: {fileID: 7400253094583230179, guid: 08887905a2dac4087ba971118e5b2afa, type: 3}
  basicMinionsPerWave: 12
  scoring:
