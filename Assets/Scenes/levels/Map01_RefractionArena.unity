--- !u!114 &324729114
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 324729109}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e165c3c81a9f94aac9ef199f5a1c6cc6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CombatPresentation
  enemyProfiles:
  - kind: 0
    displayName: Spawner
    symbol: S
    color: {r: 0.3, g: 1, b: 0.5, a: 1}
    ability: Sends more minions into the arena. Green rings warn where they will
      appear.
    killTip: Destroy the spawner, then clear its surviving minions.
  - kind: 1
    displayName: Mine layer
    symbol: L
    color: {r: 1, g: 0.6, b: 0.18, a: 1}
    ability: Roams and leaves proximity mines. Flashing rings mean a mine is arming.
    killTip: Avoid armed rings. Build speed on a clear route, then hit the layer.
  - kind: 2
    displayName: Mortar
    symbol: M
    color: {r: 0.8, g: 0.5, b: 1, a: 1}
    ability: Marks your position and launches a shell. The marked landing point stays
      fixed.
    killTip: Leave the warning circle, then line up a fast return attack.
  - kind: 3
    displayName: Basic minion
    symbol: "\u2022"
    color: {r: 1, g: 0.88, b: 0.2, a: 1}
    ability: Patrols straight horizontal, vertical, or diagonal routes, reversing
      at obstacles. Contact hurts robot form; ball form is safe.
    killTip: Bonk it in ball form at attack speed. Minion kills also help build combos.
